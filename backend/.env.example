APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./moviq.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VIDEO_PROVIDER=mock
FAL_KEY=your_fal_api_key_here
FAL_MODEL=fal-ai/kling-video/v2.5-turbo/pro/text-to-video

HF_TOKEN=your_huggingface_token_here
HF_VIDEO_MODEL=Lightricks/LTX-Video
HF_INFERENCE_PROVIDER=

WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
WAN_DEVICE=cuda
WAN_DTYPE=float16
WAN_NUM_INFERENCE_STEPS=20
WAN_GUIDANCE_SCALE=5.0
WAN_FPS=16

DIRECTOR_PROVIDER=mock
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
DIRECTOR_FALLBACK_TO_MOCK=false
GENERATION_TIMEOUT_SECONDS=600
