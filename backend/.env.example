APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./moviq.db
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
MOVIQ_EXECUTION_MODE=safe
VIDEO_PROVIDER=kie
KIE_API_KEY=your_kie_api_key_here
KIE_MODEL=kling-3.0/video
KIE_BASE_URL=https://api.kie.ai

LUMA_API_KEY=your_luma_api_key_here
HAILUO_API_KEY=your_hailuo_api_key_here

HF_TOKEN=your_huggingface_token_here
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_INFERENCE_PROVIDER=fal-ai

REMOTE_WAN_URL=http://localhost:8002
REMOTE_WAN_API_KEY=your_remote_wan_api_key_here
REMOTE_WAN_TIMEOUT_SECONDS=900
WAN_NUM_INFERENCE_STEPS=20
WAN_GUIDANCE_SCALE=5.0
WAN_FPS=16

DIRECTOR_PROVIDER=mock
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
DIRECTOR_FALLBACK_TO_MOCK=false
GENERATION_TIMEOUT_SECONDS=600
