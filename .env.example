# Moviq Environment Configuration Example

# Server Environment
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./moviq.db

# Primary Video Provider Configuration
# Supported Options: "kie", "luma", "hailuo", "huggingface", "remote_wan", "ltx", "mock"
VIDEO_PROVIDER=kie

# Provider Credentials (Backend-Only)
KIE_API_KEY=your_kie_api_key_here
KIE_BASE_URL=https://api.kie.ai

LUMA_API_KEY=your_luma_api_key_here
HAILUO_API_KEY=your_hailuo_api_key_here
HF_TOKEN=your_huggingface_token_here

# AI Director LLM Configuration
DIRECTOR_PROVIDER=mock  # "mock" or "groq"
GROQ_API_KEY=your_groq_api_key_here

# System Settings
GENERATION_TIMEOUT_SECONDS=600
ENABLE_SYNTHETIC_FALLBACK=false
HEALTH_CACHE_TTL_SECONDS=45

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_USE_MOCK_API=false
